---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { translate, pathFor, type Locale } from '../i18n';
const originalPath = Astro.originPathname || Astro.url.pathname;
const locale: Locale = originalPath === '/id' || originalPath.startsWith('/id/') ? 'id' : 'en';
const t = translate(locale);
Astro.response.status = 404;
const keys = {
 title: 'Halaman Tidak Ditemukan',
 description: 'Halaman yang Anda cari tidak ditemukan. Kembali ke beranda PT Tiga Pilar Dewata.',
 message: 'Periksa alamat halaman atau kembali ke beranda.',
 back: 'Kembali ke Beranda',
} as const;
---
<BaseLayout locale={locale} title={t(keys.title)} description={t(keys.description)}>
  <section class="section error-page container">
    <p class="eyebrow">404</p><h1 data-error="title">{t(keys.title)}</h1>
    <p data-error="message">{t(keys.message)}</p>
    <a class="button" data-error-home href={pathFor('home',locale)}><span data-error="back">{t(keys.back)}</span><Icon /></a>
  </section>
</BaseLayout>
