---
import { randomUUID } from 'node:crypto';
import AdminLayout from '../../layouts/AdminLayout.astro';
import { database, audit, transaction } from '../../cms/database';
import { categories, type PostRow } from '../../cms/blog';
import AdminIcon from '../../components/admin/AdminIcon.astro';
let error = '';
if (Astro.request.method === 'POST') {
  const form = Astro.locals.form!, id = String(form.get('id') || randomUUID());
  try {
    const action = String(form.get('action') || '');
    if (!['save', 'delete'].includes(action) || !/^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$/i.test(id)) throw new Error('Tindakan kategori tidak valid.');
    transaction(() => {
      if (action === 'delete') {
        const posts = database().prepare('SELECT draft,published FROM posts').all() as Pick<PostRow,'draft'|'published'>[];
        if (posts.some(post => [post.draft,post.published].some(json => json && JSON.parse(json).categoryId === id))) throw new Error('Kategori masih dipakai artikel atau draft. Ganti kategori artikel tersebut terlebih dahulu, termasuk yang ada di sampah.');
        database().prepare('DELETE FROM categories WHERE id=?').run(id); audit(Astro.locals.admin!.id,'category.delete',id);
      } else {
        const nameId = String(form.get('name_id') || '').trim(), nameEn = String(form.get('name_en') || '').trim();
        if (!nameId || !nameEn || nameId.length > 80 || nameEn.length > 80) throw new Error('Nama kategori ID dan EN wajib diisi, maksimal 80 karakter.');
        database().prepare('INSERT INTO categories(id,name_id,name_en) VALUES(?,?,?) ON CONFLICT(id) DO UPDATE SET name_id=excluded.name_id,name_en=excluded.name_en').run(id,nameId,nameEn); audit(Astro.locals.admin!.id,'category.save',id);
      }
    });
    return Astro.redirect('/admin/categories/?saved=1',303);
  } catch (cause) { error = (cause as Error).message; }
}
const items = categories(), csrf = Astro.locals.admin!.csrf, editingId = Astro.url.searchParams.get('edit');
---
<AdminLayout title="Kategori Blog">{error && <p class="notice error" role="alert">{error}</p>}{Astro.url.searchParams.has('saved') && <p class="notice success" role="status">Kategori berhasil diperbarui.</p>}<section class="panel category-create-panel"><div class="panel-header"><div><p class="eyebrow">TAKSONOMI ARTIKEL</p><h2>Tambah kategori</h2></div><AdminIcon name="category" size={22}/></div><form method="post"><input type="hidden" name="csrf" value={csrf}/><div class="form-grid"><label class="field"><span>Nama Indonesia</span><input name="name_id" required maxlength="80"/></label><label class="field"><span>Nama English</span><input name="name_en" required maxlength="80"/></label></div><button class="button" name="action" value="save"><AdminIcon name="plus" size={16}/>Tambah kategori</button></form></section><section class="panel category-list-panel"><div class="panel-header"><div><p class="eyebrow">DAFTAR KATEGORI</p><h2>Kategori tersimpan</h2></div><span class="badge">{items.length} kategori</span></div>{items.length ? <div class="table-wrap"><table class="category-table"><thead><tr><th>Indonesia</th><th>English</th><th>Aksi</th></tr></thead><tbody>{items.map(item => editingId === item.id ? <tr class="category-edit-row"><td colspan="3"><form method="post"><input type="hidden" name="csrf" value={csrf}/><input type="hidden" name="id" value={item.id}/><div class="form-grid"><label class="field"><span>Indonesia</span><input name="name_id" value={item.name_id} required maxlength="80"/></label><label class="field"><span>English</span><input name="name_en" value={item.name_en} required maxlength="80"/></label></div><div class="row-actions"><button class="button" name="action" value="save"><AdminIcon name="save" size={15}/>Simpan</button><a class="button secondary" href="/admin/categories/">Batal</a></div></form></td></tr> : <tr><td>{item.name_id}</td><td>{item.name_en}</td><td><div class="category-actions"><a class="icon-button" href={`/admin/categories/?edit=${item.id}`} aria-label={`Edit ${item.name_id}`} title="Edit"><AdminIcon name="edit" size={16}/></a><form method="post" data-confirm="Hapus kategori ini?"><input type="hidden" name="csrf" value={csrf}/><input type="hidden" name="id" value={item.id}/><button class="icon-button danger" name="action" value="delete" aria-label={`Hapus ${item.name_id}`} title="Hapus"><AdminIcon name="trash" size={16}/></button></form></div></td></tr>)}</tbody></table></div> : <p class="empty">Belum ada kategori.</p>}</section></AdminLayout>

