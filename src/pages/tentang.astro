---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import AboutVisual from '../components/AboutVisual.astro';
import CTA from '../components/CTA.astro';
import Icon from '../components/Icon.astro';
---
<BaseLayout title="Tentang Kami" description="PT Tiga Pilar Dewata menghadirkan Siwride untuk kebutuhan transportasi dan perjalanan di Bali.">
  <PageHero label="Tentang Kami" title="Tentang PT Tiga Pilar Dewata" description="Perusahaan di bidang transportasi dan perjalanan melalui Siwride." />
  <section class="section"><div class="container about-grid"><AboutVisual /><div><SectionHeading title="Profil Perusahaan" description="PT Tiga Pilar Dewata menghadirkan Siwride sebagai satu-satunya produk perusahaan, dengan fokus transportasi dan perjalanan di Bali." /><ul class="check-list"><li>Platform pemesanan kendaraan</li><li>Pengelolaan layanan bersama tim dan mitra</li><li>Fokus perjalanan di Bali</li></ul><a class="button" href="/siwride/">Lihat Produk Siwride <Icon /></a></div></div></section>
  <CTA />
</BaseLayout>
