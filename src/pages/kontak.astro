---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Icon from '../components/Icon.astro';
import { contact } from '../data/company';
---
<BaseLayout title="Kontak" description="Hubungi tim untuk informasi perusahaan, Siwride, dan peluang kerja sama.">
  <PageHero label="Kontak" title="Kontak" description="Informasi perusahaan, Siwride, dan peluang kerja sama." />
  <section class="section"><div class="container contact-grid"><div><SectionHeading eyebrow="Hubungi Kami" title="Informasi Kontak" /><p>Hubungi kami melalui email atau telepon untuk informasi Siwride dan kerja sama.</p></div><div class="contact-list"><article><Icon name="mail"/><div><p class="eyebrow">Email</p><a href={`mailto:${contact.email}`}>{contact.email}</a></div></article><article><Icon name="phone"/><div><p class="eyebrow">Telepon</p><a href={`tel:${contact.phoneHref}`}>{contact.phone}</a></div></article><article><Icon name="pin"/><div><p class="eyebrow">Alamat Korespondensi</p><address>{contact.address}</address></div></article></div></div></section>
</BaseLayout>
