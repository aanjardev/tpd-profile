---
import BaseLayout from '../layouts/BaseLayout.astro';
import BlogCards from '../components/BlogCards.astro';
import { listPublished, categories, postPath, renderMarkdown, type PublicPost } from '../cms/blog';
import { translate, pathFor, type Locale } from '../i18n';
interface Props { locale: Locale; post: PublicPost; }
const { locale, post } = Astro.props, t = translate(locale);
const data = post.content;
const languagePaths: Partial<Record<Locale,string>> = {};
for (const language of ['en','id'] as const) {
  const translation = listPublished(language).find(item => item.translation_group === post!.translation_group);
  if (translation) languagePaths[language] = postPath(translation);
}
if (Astro.locals.preview) languagePaths[locale] = postPath(post);
const category = categories().find(item => item.id === data.categoryId);
const related = listPublished(locale).filter(item => item.id !== post!.id && (!data.categoryId || item.content.categoryId === data.categoryId)).slice(0,3);
const date = post.first_published_at;
---
<BaseLayout locale={locale} page="blog" title={data.seoTitle || data.title} description={data.seoDescription || data.excerpt} canonicalPath={postPath(post)} languagePaths={languagePaths} image={data.cover}>
  <article class="blog-article"><header class="article-header container"><a class="text-link" href={pathFor('blog',locale)}>← {t('Kembali ke blog')}</a><div class="blog-meta">{category && <span>{locale === 'id' ? category.name_id : category.name_en}</span>}{date && <time datetime={date}>{new Date(date).toLocaleDateString(locale === 'id' ? 'id-ID' : 'en-GB',{day:'numeric',month:'long',year:'numeric',timeZone:'Asia/Jakarta'})}</time>}<span>{data.author}</span></div><h1>{data.title}</h1><p class="lead">{data.excerpt}</p></header>{data.cover && <figure class="article-cover container"><img src={data.cover} alt={data.coverAlt} width="1600" height="900" fetchpriority="high"/></figure>}<div class="article-body container" set:html={renderMarkdown(data.body)}></div><footer class="article-footer container"><a class="text-link" href={pathFor('blog',locale)}>← {t('Kembali ke blog')}</a><button class="button" id="share-article">{t('Bagikan artikel')}</button><p id="share-status" aria-live="polite"></p></footer></article>
  {related.length > 0 && <section class="section section-tint"><div class="container"><h2>{t('Artikel terkait')}</h2><BlogCards posts={related} locale={locale}/></div></section>}
</BaseLayout>
<script>
  document.querySelector('#share-article')?.addEventListener('click',async () => {
    const target = new URL(location.href); target.search = ''; target.hash = '';
    try { if(navigator.share) await navigator.share({ title:document.title,url:target.href }); else { await navigator.clipboard.writeText(target.href); document.querySelector('#share-status')!.textContent = document.documentElement.lang === 'id' ? 'Tautan disalin.' : 'Link copied.'; } }
    catch { document.querySelector('#share-status')!.textContent = target.href; }
  });
</script>
