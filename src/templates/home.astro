---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ServiceCards from '../components/ServiceCards.astro';
import CTA from '../components/CTA.astro';
import Icon from '../components/Icon.astro';
import AboutVisual from '../components/AboutVisual.astro';
import BlogCards from '../components/BlogCards.astro';
import { getSiteContent } from '../cms/content';
import { listPublished } from '../cms/blog';
import { translate, pathFor, type Locale } from '../i18n';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const t = translate(locale);
const { visuals, partners } = getSiteContent(locale);
const latestPosts = listPublished(locale).slice(0,3);
---
<BaseLayout locale={locale} page="home">
  <section class="home-hero"><div class="container hero-grid">
    <div class="hero-copy"><p class="eyebrow">{t("PT Tiga Pilar Dewata")}</p><h1>{t("Transportasi dan perjalanan di Bali")}</h1><p class="lead">{t("PT Tiga Pilar Dewata menghadirkan Siwride, platform pemesanan kendaraan dan pengelolaan transportasi.")}</p><div class="button-group"><a class="button" href={pathFor("about", locale)}>{t("Tentang Perusahaan")} <Icon /></a><a class="button" href={pathFor("siwride", locale)}>{t("Lihat Siwride")} <Icon /></a></div></div>
    <figure class="hero-photo"><div class="photo-frame"><img src={visuals.hero} alt={t("Visual perjalanan di jalan pesisir Bali dengan kendaraan dan gerbang khas Bali")} width="1448" height="1086" fetchpriority="high" /></div><span class="photo-dots" aria-hidden="true"></span></figure>
  </div></section>
  <section class="section"><div class="container about-grid"><AboutVisual locale={locale} /><div><SectionHeading eyebrow={t("Tentang Kami")} title={t("PT Tiga Pilar Dewata")} description={t("Perusahaan yang berfokus pada transportasi dan perjalanan di Bali melalui produk Siwride.")} /><ul class="check-list"><li>{t("Fokus transportasi dan perjalanan")}</li><li>{t("Siwride sebagai produk perusahaan")}</li><li>{t("Kerja sama travel dan transportasi")}</li></ul><a class="button" href={pathFor("about", locale)}>{t("Tentang Perusahaan")} <Icon /></a></div></div></section>
  <section class="section section-tint section-dark" id="layanan"><div class="container"><div class="center-heading"><SectionHeading eyebrow={t("Produk & Layanan")} title={t("Layanan Siwride")} description={t("Transfer bandara, paket wisata, perjalanan bersama, dan sewa kendaraan dengan pengemudi.")} /></div><ServiceCards locale={locale} /><div class="center-action"><a class="button" href={pathFor("siwride", locale)}>{t("Lihat Produk")} <Icon /></a></div></div></section>
  <section class="section"><div class="container"><div class="center-heading"><SectionHeading eyebrow={t("Kemitraan")} title={t("Kerja Sama")} description={t("Untuk pelaku travel, pemandu wisata, dan mitra transportasi.")} /></div><div class="three-grid compact-cards">{partners.map((partner,i)=><a class="partner-card" href={pathFor("partnership", locale)}><span class="card-number">{String(i+1).padStart(2,'0')}</span><h3>{partner.title}</h3><Icon /></a>)}</div></div></section>
  <section class="section section-tint"><div class="container"><div class="center-heading"><SectionHeading eyebrow={t('Blog')} title={t('Terbaru dari kami')}/></div>{latestPosts.length ? <BlogCards posts={latestPosts} locale={locale}/> : <div class="blog-empty"><p>{t('Belum ada artikel.')}</p></div>}<div class="center-action"><a class="button" href={pathFor('blog',locale)}>{t('Semua artikel')} <Icon/></a></div></div></section>
  <CTA locale={locale} />
</BaseLayout>
