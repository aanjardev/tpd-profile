---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Icon from '../components/Icon.astro';
import { getSiteContent } from '../cms/content';
import { translate, type Locale } from '../i18n';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const { contact } = getSiteContent(locale);
const t = translate(locale);
---
<BaseLayout locale={locale} page="contact" title={t("Kontak")} description={t("Hubungi tim untuk informasi perusahaan, Siwride, dan peluang kerja sama.")}>
  <PageHero label={t("Kontak")} title={t("Kontak")} description={t("Informasi perusahaan, Siwride, dan peluang kerja sama.")} />
  <section class="section"><div class="container contact-grid"><div><SectionHeading eyebrow={t("Hubungi Kami")} title={t("Informasi Kontak")} /><p>{t("Hubungi kami melalui email atau telepon untuk informasi Siwride dan kerja sama.")}</p></div><div class="contact-list"><article><Icon name="mail"/><div><p class="eyebrow">{t("Email")}</p><a href={`mailto:${contact.email}`}>{contact.email}</a></div></article><article><Icon name="phone"/><div><p class="eyebrow">{t("Telepon")}</p><a href={`tel:${contact.phoneHref}`}>{contact.phone}</a></div></article><article><Icon name="pin"/><div><p class="eyebrow">{t("Alamat Korespondensi")}</p><address>{contact.address}</address></div></article></div></div></section>
  <section class="section section-tint"><div class="container contact-form-layout"><div><SectionHeading eyebrow={t("Pesan untuk Kami")} title={t("Hubungi kami")} /><p class="section-description">{t("Kirim pertanyaan atau kebutuhan kerja sama. Tim kami akan membaca pesan Anda.")}</p></div><div>{Astro.url.searchParams.get('contact') === 'success' && <p class="notice success" role="status">{t("Pesan berhasil dikirim. Terima kasih.")}</p>}{Astro.url.searchParams.get('contact') === 'error' && <p class="notice error" role="alert">{t("Periksa isian formulir, lalu coba lagi.")}</p>}<form class="contact-form" method="post" action="/api/contact/"><input type="hidden" name="return_to" value={Astro.url.pathname}/><input type="hidden" name="locale" value={locale}/><label class="field"><span>{t("Nama")} *</span><input name="name" required maxlength="120" autocomplete="name" /></label><label class="field"><span>{t("Email")} *</span><input type="email" name="email" required maxlength="254" autocomplete="email" /></label><label class="field"><span>{t("Nomor telepon")}</span><input name="phone" maxlength="40" autocomplete="tel" /></label><label class="field"><span>{t("Pesan")} *</span><textarea name="message" required minlength="10" maxlength="5000" rows="6"></textarea></label><label class="contact-honeypot" aria-hidden="true">Website<input name="website" tabindex="-1" autocomplete="off" /></label><button class="button" type="submit">{t("Kirim pesan")}</button></form></div></div></section>
  {(contact.whatsapp || contact.productUrl) && <section class="container contact-extra button-group">{contact.whatsapp && <a class="button" href={`https://wa.me/${contact.whatsapp}`}>WhatsApp</a>}{contact.productUrl && <a class="button" href={contact.productUrl}>Siwride <Icon /></a>}</section>}
</BaseLayout>
