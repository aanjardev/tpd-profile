---
import '../styles/admin.css';
import AdminIcon from '../components/admin/AdminIcon.astro';
import { database } from '../cms/database';
interface Props { title: string; }
const { title } = Astro.props;
const admin = Astro.locals.admin;
const unreadMessages = admin ? Number((database().prepare('SELECT COUNT(*) AS total FROM contact_messages WHERE read_at IS NULL').get() as { total: number }).total || 0) : 0;
const navGroups = [
  { label: 'Ringkasan', items: [{ href: '/admin/', label: 'Ringkasan', icon: 'dashboard' }] },
  { label: 'Konten website', items: [
    { href: '/admin/content/?scope=global', label: 'Identitas & Kontak', icon: 'identity' },
    { href: '/admin/content/?scope=id', label: 'Konten Website', icon: 'content' },
  ] },
  { label: 'Publikasi', items: [
    { href: '/admin/blog/', label: 'Artikel Blog', icon: 'article' },
    { href: '/admin/categories/', label: 'Kategori Blog', icon: 'category' },
    { href: '/admin/media/', label: 'Pustaka Media', icon: 'media' },
  ] },
  { label: 'Komunikasi', items: [{ href: '/admin/messages/', label: 'Pesan masuk', icon: 'mail', badge: unreadMessages }] },
  { label: 'Akun', items: [{ href: '/admin/account/', label: 'Akun Saya', icon: 'account' }] },
];
function isActive(href: string) {
  const target = new URL(href, Astro.url);
  const currentScope = Astro.url.searchParams.get('scope') || 'id';
  const matchesScope = target.searchParams.get('scope') === 'id'
    ? currentScope !== 'global'
    : (target.searchParams.get('scope') || '') === (Astro.url.searchParams.get('scope') || '');
  return target.pathname === Astro.url.pathname && matchesScope;
}
---
<!doctype html><html lang="id"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content="noindex,nofollow"/><link rel="icon" href="/favicon.ico"/><title>{title} | Admin Tiga Pilar Dewata</title></head>
<body class:list={['admin-body', { 'login-body': !admin }]}>
  <a class="admin-skip" href="#admin-main">Lewati navigasi</a>
  {admin && <aside class="admin-sidebar">
    <a class="admin-brand" href="/admin/"><img src="/brand/symbol.png" width="44" height="44" alt=""/><span>TIGA PILAR DEWATA<small>CONTENT STUDIO</small></span></a>
    <nav class="admin-nav" aria-label="Navigasi admin">{navGroups.map(group => <div class="admin-nav-group"><p>{group.label}</p>{group.items.map(item => <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}><AdminIcon name={item.icon} size={17}/><span>{item.label}</span>{(item as { badge?: number }).badge ? <b class="nav-badge">{(item as { badge?: number }).badge}</b> : null}</a>)}</div>)}</nav>
    <div class="sidebar-bottom"><div class="sidebar-user"><span class="admin-avatar">{admin.name.slice(0, 1).toUpperCase()}</span><span><strong>{admin.name}</strong><small>Administrator</small></span></div></div>
  </aside>}
  <main id="admin-main" class="admin-main"><header class="admin-topbar"><div class="admin-page-title"><strong>{title}</strong></div><div class="admin-topbar-actions"><a href="/" target="_blank" rel="noopener"><AdminIcon name="external" size={15}/>Lihat website</a>{admin && <form action="/admin/logout/" method="post"><input type="hidden" name="csrf" value={admin.csrf}/><button><AdminIcon name="logout" size={15}/>Keluar</button></form>}</div></header><div class="admin-workspace"><slot/></div></main>
</body></html>
<script>
  document.querySelectorAll<HTMLFormElement>('form[data-confirm]').forEach(form => form.addEventListener('submit', event => {
    if (!window.confirm(form.dataset.confirm || 'Lanjutkan?')) event.preventDefault();
  }));
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach(button => button.addEventListener('click', async () => {
    try { await navigator.clipboard.writeText(button.dataset.copy || ''); button.setAttribute('aria-label', 'Tautan tersalin'); button.setAttribute('title', 'Tautan tersalin'); button.classList.add('is-copied'); }
    catch { const field = button.parentElement?.querySelector('input'); field?.focus(); field?.select(); }
  }));
  document.querySelectorAll<HTMLFormElement>('form[data-editor]').forEach(form => {
    let dirty = false;
    form.addEventListener('input', () => { dirty = true; });
    form.addEventListener('editor:saved', () => { dirty = false; });
    document.addEventListener('submit', event => { if (event.target === form && !event.defaultPrevented) dirty = false; });
    window.addEventListener('beforeunload', event => { if (dirty) event.preventDefault(); });
  });
</script>
