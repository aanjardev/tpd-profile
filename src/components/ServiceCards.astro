---
import type { Locale } from '../i18n';
interface Props { locale: Locale; }
const { locale } = Astro.props;
import { getSiteContent } from '../cms/content';
const { services } = getSiteContent(locale);
import Icon from './Icon.astro';
---
<div class="service-grid">{services.map(service => <article class="service-card"><div class="service-icon"><Icon name={service.icon}/></div><div><h3>{service.title}</h3><p>{service.description}</p></div></article>)}</div>
