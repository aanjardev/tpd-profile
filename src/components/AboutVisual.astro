---
import { translate, type Locale } from '../i18n';
import { getSiteContent } from '../cms/content';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const t = translate(locale);
const { visuals } = getSiteContent(locale);
---
<figure class="about-visual"><img src={visuals.about} alt={t("Visual arsitektur Bali dengan jalur yang menghubungkan paviliun")} width="1448" height="1086" loading="lazy" /></figure>
