---
import { translate, pathFor, type Locale } from '../i18n';
interface Props { locale: Locale; footer?: boolean; }
const { locale } = Astro.props;
const t = translate(locale);
const { footer = false } = Astro.props;
---
<a href={pathFor("home", locale)} class:list={['brand', { 'brand-footer': footer }]} aria-label={`PT Tiga Pilar Dewata — ${t("Beranda")}`}>
  <span class="brand-symbol"><img src="/brand/symbol.png" width="64" height="64" alt="" /></span>
  <span class="brand-name">PT TIGA PILAR<span>DEWATA</span></span>
</a>
