---
interface Props { label: string; title: string; description: string; }
const { label, title, description } = Astro.props;
---
<section class="page-hero" aria-label={label}><div class="container">
  <div class="page-hero-grid"><h1>{title}</h1><p class="lead">{description}</p></div>
</div></section>

<style>
  .page-hero {
    display: grid;
    place-items: center;
    min-height: 0;
    padding-block: 48px;
    background: #0b2138;
    overflow: hidden;
    text-align: center;
  }
  .page-hero::before {
    background-image: linear-gradient(#afc7df66 1px, transparent 1px), linear-gradient(90deg, #afc7df66 1px, transparent 1px);
    background-size: 48px 48px;
    background-position: center;
    mask-image: linear-gradient(90deg, #000, #000d 45%, #000d 55%, #000);
  }
  .page-hero::after {
    content: '';
    position: absolute;
    width: 96px;
    height: 96px;
    right: 8%;
    bottom: -32px;
    border: 1px solid #b38a3559;
    box-shadow: -48px -48px 0 -1px #0b2138, -48px -48px 0 0 #a2bad52b;
    pointer-events: none;
    z-index: -1;
  }
  .page-hero-grid {
    position: relative;
    max-width: 900px;
    margin-inline: auto;
  }
  .page-hero h1 {
    font-size: clamp(32px, 3.4vw, 48px);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -.04em;
    text-wrap: balance;
    margin: 0 0 16px;
  }
  .page-hero .lead {
    max-width: 650px;
    margin: 0 auto;
    font-size: 18px;
    line-height: 1.7;
    text-wrap: pretty;
    color: #cddbea;
  }
  @media (max-width: 767px) {
    .page-hero { padding-block: 32px; }
    .page-hero::before { background-size: 36px 36px; }
    .page-hero::after { right: -36px; opacity: .6; }
    .page-hero h1 { margin-bottom: 12px; }
    .page-hero .lead { font-size: 16px; line-height: 1.6; }
  }
</style>
