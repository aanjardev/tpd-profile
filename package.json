{
  "name": "tigapilardewata",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=24.22.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "start": "node dist/server/entry.mjs",
    "check": "astro check",
    "admin:create": "node --env-file-if-exists=.env scripts/admin.mjs",
    "test:cms": "node scripts/test-cms.mjs",
    "test:browser": "node scripts/test-cms.mjs --browser",
    "deploy:snail2": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/deploy-snail2.ps1",
    "rollback:snail2": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/deploy-snail2.ps1 -Action rollback",
    "verify:snail2": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/deploy-snail2.ps1 -Action verify",
    "test:i18n": "node scripts/test-i18n.mjs",
    "test:contact": "node scripts/test-contact-analytics.mjs",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.11",
    "@fontsource/inter": "^5.3.0",
    "@phosphor-icons/core": "^2.1.1",
    "astro": "^7.4.1",
    "entities": "^4.5.0",
    "marked": "^18.1.3",
    "sanitize-html": "^2.18.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@types/sanitize-html": "^2.16.2",
    "typescript": "^6.0.3"
  }
}
